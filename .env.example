# Copy to .env and fill in. Missing keys cause that source to be skipped.

# Reed - free at https://www.reed.co.uk/developers
REED_API_KEY=

# Adzuna - free at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble - free at https://jooble.org/api/about
JOOBLE_API_KEY=

# SerpApi (paid) - https://serpapi.com/ - used for LinkedIn Jobs + Indeed
SERPAPI_KEY=

# Email digest (SMTP). Gmail app-password works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
