# Copy to .env and fill in. The app reads these via os.environ.

# Reed — https://www.reed.co.uk/developers (free)
REED_API_KEY=

# Adzuna — https://developer.adzuna.com/ (free tier, ~250 calls/day)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Override the SQLite path (default: data/jobs.db)
# JOB_DB_PATH=data/jobs.db
